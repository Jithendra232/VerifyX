MONGO_URI=mongodb://localhost:27017/supply-chain
CLERK_SECRET_KEY=your_clerk_secret_key

# Comma-separated admin emails (normalized on sync). New sign-ups with these emails get role "admin".
ADMIN_EMAILS=admin@example.com

# Enable isolated demo seed/reset API (admin only): POST /api/demo/seed, DELETE /api/demo/reset
DEMO_MODE_ENABLED=false

